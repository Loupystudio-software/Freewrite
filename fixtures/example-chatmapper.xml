<?xml version="1.0" encoding="utf-8"?>
<ChatMapperProject xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <Title>Sunrise Valley</Title>
  <Description>Example demonstration project with branching dialogue.</Description>
  <Author>Freewrite Team</Author>
  <Actors>
    <Actor ID="1" Name="Mira">
      <Fields>
        <Field Name="IsPlayer" Type="Boolean">False</Field>
        <Field Name="Description" Type="Text">Local scout leader in Sunrise Valley.</Field>
      </Fields>
    </Actor>
    <Actor ID="2" Name="Player">
      <Fields>
        <Field Name="IsPlayer" Type="Boolean">True</Field>
        <Field Name="Description" Type="Text">The protagonist.</Field>
      </Fields>
    </Actor>
  </Actors>
  <Variables>
    <Variable ID="1" Type="Boolean" Default="False">HasMetMira</Variable>
  </Variables>
  <Conversations>
    <Conversation ID="1" Title="Mira Introduction">
      <DialogEntries>
        <DialogEntry ID="0" PID="0" IsRoot="true">
          <Fields>
            <Field Name="canvasRect" Type="Text">100;50</Field>
          </Fields>
          <Text>START</Text>
          <Links>
            <Link OriginConversationID="1" OriginDialogEntryID="0" DestinationConversationID="1" DestinationDialogEntryID="1" IsDefault="true" />
          </Links>
        </DialogEntry>
        <DialogEntry ID="1" PID="1" Actor="1" Conversant="1">
          <Fields>
            <Field Name="canvasRect" Type="Text">80;160</Field>
          </Fields>
          <Text>Welcome to Sunrise. Have we met before?</Text>
          <Links>
            <Link OriginConversationID="1" OriginDialogEntryID="1" DestinationConversationID="1" DestinationDialogEntryID="2" IsDefault="true" />
            <Link OriginConversationID="1" OriginDialogEntryID="1" DestinationConversationID="1" DestinationDialogEntryID="3" IsDefault="true" />
          </Links>
        </DialogEntry>
        <DialogEntry ID="2" PID="2" Actor="2" Conversant="1">
          <Fields>
            <Field Name="Menu Text" Type="Text">I don&apos;t think so.</Field>
            <Field Name="canvasRect" Type="Text">-60;320</Field>
          </Fields>
          <Text>I don&apos;t think so. I just arrived here from the south.</Text>
          <Links>
            <Link OriginConversationID="1" OriginDialogEntryID="2" DestinationConversationID="1" DestinationDialogEntryID="4" IsDefault="true" />
          </Links>
        </DialogEntry>
        <DialogEntry ID="3" PID="3" Actor="2" Conversant="1">
          <Fields>
            <Field Name="Menu Text" Type="Text">Yes, in New Dawn.</Field>
            <Field Name="canvasRect" Type="Text">260;320</Field>
          </Fields>
          <Text>Yes, back in New Dawn during the harvest season.</Text>
          <Links>
            <Link OriginConversationID="1" OriginDialogEntryID="3" DestinationConversationID="1" DestinationDialogEntryID="4" IsDefault="true" />
          </Links>
        </DialogEntry>
        <DialogEntry ID="4" PID="4" Actor="1" Conversant="1">
          <Fields>
            <Field Name="canvasRect" Type="Text">80;480</Field>
          </Fields>
          <Text>Well, either way, keep your eyes open. These trails aren&apos;t as quiet as they used to be.</Text>
          <Links>
            <Link OriginConversationID="1" OriginDialogEntryID="4" DestinationConversationID="1" DestinationDialogEntryID="5" IsDefault="true" />
          </Links>
        </DialogEntry>
        <DialogEntry ID="5" PID="5" Actor="0" Conversant="1">
          <Fields>
            <Field Name="canvasRect" Type="Text">100;640</Field>
          </Fields>
          <Text></Text>
          <UserScript>set_variable()</UserScript>
          <Links>
            <Link OriginConversationID="1" OriginDialogEntryID="5" DestinationConversationID="1" DestinationDialogEntryID="6" IsDefault="true" />
          </Links>
        </DialogEntry>
        <DialogEntry ID="6" PID="6" Actor="0" Conversant="1">
          <Fields>
            <Field Name="canvasRect" Type="Text">120;760</Field>
          </Fields>
          <Text></Text>
        </DialogEntry>
      </DialogEntries>
    </Conversation>
  </Conversations>
</ChatMapperProject>